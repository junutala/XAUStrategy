//@version=5
indicator("Triple EMA Cross Alerts", overlay=true, max_labels_count=500)

// =====================================================================
//  Triple EMA Cross Alerts
//  Alerts when EMA1 crosses EMA2 and when EMA1 crosses EMA3.
//  Use TradingView's Alert dialog (Create Alert) to enable:
//    - "Play sound"     -> for the audible alert
//    - "Show popup"     -> for the on-screen notification
//    - Use TradingView Desktop App to get OS-level pop-ups that
//      appear ON TOP of any other windows you have open.
// =====================================================================

// ----------- INPUTS -----------
ema1_len    = input.int(7,   title="EMA 1 Length", minval=1)
ema2_len    = input.int(21,  title="EMA 2 Length", minval=1)
ema3_len    = input.int(50,  title="EMA 3 Length", minval=1)
src         = input.source(close, title="Source")
show_marks  = input.bool(true,  title="Show cross markers on chart")
use_close   = input.bool(true,  title="Trigger only on bar close (no repaint)")

// ----------- EMA CALCULATIONS -----------
ema1 = ta.ema(src, ema1_len)
ema2 = ta.ema(src, ema2_len)
ema3 = ta.ema(src, ema3_len)

// ----------- PLOT EMAs -----------
plot(ema1, title="EMA 1", color=color.new(#00E676, 0), linewidth=2)
plot(ema2, title="EMA 2", color=color.new(#FF1744, 0), linewidth=2)
plot(ema3, title="EMA 3", color=color.new(#2962FF, 0), linewidth=2)

// ----------- CROSS DETECTION -----------
cross12_up   = ta.crossover(ema1, ema2)    // EMA1 crosses ABOVE EMA2
cross12_down = ta.crossunder(ema1, ema2)   // EMA1 crosses BELOW EMA2
cross13_up   = ta.crossover(ema1, ema3)    // EMA1 crosses ABOVE EMA3
cross13_down = ta.crossunder(ema1, ema3)   // EMA1 crosses BELOW EMA3

// Optional: fire only on bar-close to avoid intrabar repaint
fire_12_up   = use_close ? (cross12_up   and barstate.isconfirmed) : cross12_up
fire_12_down = use_close ? (cross12_down and barstate.isconfirmed) : cross12_down
fire_13_up   = use_close ? (cross13_up   and barstate.isconfirmed) : cross13_up
fire_13_down = use_close ? (cross13_down and barstate.isconfirmed) : cross13_down

// ----------- ON-CHART MARKERS -----------
plotshape(show_marks and cross12_up,   title="EMA1 x EMA2 Up",
     style=shape.triangleup,   location=location.belowbar,
     color=color.new(color.green, 0), size=size.small,  text="1↑2")
plotshape(show_marks and cross12_down, title="EMA1 x EMA2 Down",
     style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red,   0), size=size.small,  text="1↓2")
plotshape(show_marks and cross13_up,   title="EMA1 x EMA3 Up",
     style=shape.triangleup,   location=location.belowbar,
     color=color.new(color.lime, 0),  size=size.normal, text="1↑3")
plotshape(show_marks and cross13_down, title="EMA1 x EMA3 Down",
     style=shape.triangledown, location=location.abovebar,
     color=color.new(color.maroon, 0), size=size.normal, text="1↓3")

// Cross markers ON the EMA1 line itself
plot(show_marks and (cross12_up or cross12_down) ? ema1 : na,
     title="Cross 1-2 marker", style=plot.style_cross, linewidth=4,
     color=cross12_up ? color.green : color.red)
plot(show_marks and (cross13_up or cross13_down) ? ema1 : na,
     title="Cross 1-3 marker", style=plot.style_cross, linewidth=4,
     color=cross13_up ? color.lime : color.maroon)

// ----------- ALERT CONDITIONS (for the "Create Alert" dialog) -----------
// Each of these will appear in the "Condition" dropdown when you create an alert.
alertcondition(fire_12_up,
     title="EMA1 crosses ABOVE EMA2",
     message="🔼 EMA1 crossed ABOVE EMA2 on {{ticker}} ({{interval}}) @ {{close}}")
alertcondition(fire_12_down,
     title="EMA1 crosses BELOW EMA2",
     message="🔽 EMA1 crossed BELOW EMA2 on {{ticker}} ({{interval}}) @ {{close}}")
alertcondition(fire_13_up,
     title="EMA1 crosses ABOVE EMA3",
     message="🚀 EMA1 crossed ABOVE EMA3 on {{ticker}} ({{interval}}) @ {{close}}")
alertcondition(fire_13_down,
     title="EMA1 crosses BELOW EMA3",
     message="⚠️ EMA1 crossed BELOW EMA3 on {{ticker}} ({{interval}}) @ {{close}}")

// Combined "Any cross" -> create ONE alert that fires on all four events
any_cross = fire_12_up or fire_12_down or fire_13_up or fire_13_down
alertcondition(any_cross,
     title="Any EMA Cross",
     message="EMA cross detected on {{ticker}} ({{interval}}) @ {{close}}")

// ----------- DYNAMIC alert() CALLS -----------
// These let a single alert created with the "Any alert() function call"
// condition fire with a specific message per event.
if fire_12_up
    alert("🔼 EMA1 ↑ EMA2 on " + syminfo.ticker + " (" + timeframe.period + ") @ " + str.tostring(close), alert.freq_once_per_bar_close)
if fire_12_down
    alert("🔽 EMA1 ↓ EMA2 on " + syminfo.ticker + " (" + timeframe.period + ") @ " + str.tostring(close), alert.freq_once_per_bar_close)
if fire_13_up
    alert("🚀 EMA1 ↑ EMA3 on " + syminfo.ticker + " (" + timeframe.period + ") @ " + str.tostring(close), alert.freq_once_per_bar_close)
if fire_13_down
    alert("⚠️ EMA1 ↓ EMA3 on " + syminfo.ticker + " (" + timeframe.period + ") @ " + str.tostring(close), alert.freq_once_per_bar_close)
